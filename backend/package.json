{
  "name": "laut-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run prisma:generate && tsc",
    "start": "node dist/server.js",
    "typecheck": "npm run prisma:generate && tsc --noEmit",
    "test": "tsx --test test/index.test.ts",
    "test:hosted": "set RUN_HOSTED_INTEGRATION_TESTS=true&& tsx --test test/hosted-analysis.integration.test.ts",
    "import:synthetic-red-snapper": "tsx src/scripts/import-synthetic-red-snapper.ts",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/google": "^0.2.3",
    "@langchain/langgraph": "^1.4.12",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@supabase/supabase-js": "^2.112.3",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "pg": "8.23.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.10.1",
    "@types/pg": "8.15.6",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "7.9.1",
    "tsx": "4.23.0",
    "typescript": "5.7.2"
  }
}
