PORT=8000
# Comma-separated allowed browser origins. During local development LAUT also
# accepts Next's automatic fallback at http://localhost:3001.
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
# Optional: required only for `npm run test:hosted`.
TEST_SUPABASE_ACCESS_TOKEN=<test-user-access-token>
GOOGLE_API_KEY=<google-ai-studio-api-key>
GEMINI_MODEL=gemini-3.5-flash-lite
VONAGE_API_KEY=<vonage-api-key>
VONAGE_API_SECRET=<vonage-api-secret>
VONAGE_WHATSAPP_FROM=<sandbox-or-production-sender-number>
VONAGE_MESSAGES_API_URL=https://messages-sandbox.nexmo.com/v1/messages
VONAGE_SIGNATURE_SECRET=<vonage-webhook-signature-secret>
# Retained for Vonage application-key deployments.
VONAGE_APPLICATION_ID=<vonage-application-id>
VONAGE_PRIVATE_KEY_PATH=<path-to-vonage-private-key>
