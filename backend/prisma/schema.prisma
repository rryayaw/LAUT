generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"]
}

// Supabase Auth owns this table. It preserves the foreign-key relationship
// from public.profiles but is never migrated or written by Prisma.
model AuthUser {
  id      String   @id @db.Uuid
  email   String?  @db.Text
  profile Profile?

  @@map("users")
  @@schema("auth")
}

model Profile {
  id          String           @id @db.Uuid
  email       String           @db.Text
  displayName String?          @map("display_name") @db.Text
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  authUser    AuthUser         @relation(fields: [id], references: [id], onDelete: Cascade)
  sites       ManufacturingSite[]
  auditEvents ProductionBatchAuditEvent[]

  @@map("profiles")
  @@schema("public")
}

model ManufacturingSite {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @db.Text
  timezone        String           @default("Asia/Jakarta") @db.Text
  ownerId         String           @map("owner_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner           Profile          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  productionLines ProductionLine[]
  productionBatches ProductionBatch[]

  @@index([ownerId])
  @@map("manufacturing_sites")
  @@schema("public")
}

model ProductionLine {
  id               String         @id @default(uuid()) @db.Uuid
  manufacturingSiteId String      @map("manufacturing_site_id") @db.Uuid
  name             String         @db.Text
  description      String?        @db.Text
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  manufacturingSite ManufacturingSite @relation(fields: [manufacturingSiteId], references: [id], onDelete: Cascade)
  capabilityTagLinks ProductionLineCapabilityTag[]
  batchLinks       ProductionBatchLine[]

  @@unique([manufacturingSiteId, name])
  @@unique([id, manufacturingSiteId])
  @@index([manufacturingSiteId])
  @@map("production_lines")
  @@schema("public")
}

model CapabilityTag {
  id              String                     @id @default(uuid()) @db.Uuid
  code            String                     @unique @db.Text
  label           String                     @unique @db.Text
  description     String?                    @db.Text
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  productionLines ProductionLineCapabilityTag[]

  @@map("capability_tags")
  @@schema("public")
}

model ProductionLineCapabilityTag {
  productionLineId String         @map("production_line_id") @db.Uuid
  capabilityTagId  String         @map("capability_tag_id") @db.Uuid
  otherContext     String?        @map("other_context") @db.Text
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  productionLine   ProductionLine @relation(fields: [productionLineId], references: [id], onDelete: Cascade)
  capabilityTag    CapabilityTag  @relation(fields: [capabilityTagId], references: [id], onDelete: Restrict)

  @@id([productionLineId, capabilityTagId])
  @@index([capabilityTagId])
  @@map("production_line_capability_tags")
  @@schema("public")
}

model ProductionBatch {
  id                        String                @id @default(uuid()) @db.Uuid
  manufacturingSiteId       String                @map("manufacturing_site_id") @db.Uuid
  status                    String                @default("draft") @db.Text
  sourceChannel             String                @default("web") @map("source_channel") @db.Text
  batchReference            String?               @map("batch_reference") @db.Text
  productionDate            DateTime              @default(now()) @map("production_date") @db.Date
  species                   String?               @db.Text
  productSpecification      String?               @map("product_specification") @db.Text
  rawInputKg                Decimal?              @map("raw_input_kg") @db.Decimal(14, 3)
  sellableOutputKg          Decimal?              @map("sellable_output_kg") @db.Decimal(14, 3)
  trimmingKg                Decimal?              @map("trimming_kg") @db.Decimal(14, 3)
  qualityRejectKg           Decimal?              @map("quality_reject_kg") @db.Decimal(14, 3)
  byproductKg               Decimal?              @map("byproduct_kg") @db.Decimal(14, 3)
  spoilageKg                Decimal?              @map("spoilage_kg") @db.Decimal(14, 3)
  otherLossKg               Decimal?              @map("other_loss_kg") @db.Decimal(14, 3)
  supplier                  String?               @db.Text
  shift                     String?               @db.Text
  fishSizeCategory          String?               @map("fish_size_category") @db.Text
  storageState              String?               @map("storage_state") @db.Text
  receivingCondition        String?               @map("receiving_condition") @db.Text
  receivingTemperatureC     Decimal?              @map("receiving_temperature_c") @db.Decimal(5, 2)
  deliveryDelayMinutes      Int?                  @map("delivery_delay_minutes")
  productionDurationMinutes Int?                  @map("production_duration_minutes")
  operatorNotes             String?               @map("operator_notes") @db.Text
  confirmedAt               DateTime?             @map("confirmed_at") @db.Timestamptz(6)
  createdAt                 DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  manufacturingSite         ManufacturingSite     @relation(fields: [manufacturingSiteId], references: [id], onDelete: Restrict)
  lineLinks                 ProductionBatchLine[]
  auditEvents               ProductionBatchAuditEvent[]
  analysis                  ProductionBatchAnalysis?

  @@unique([id, manufacturingSiteId])
  @@index([manufacturingSiteId, status, productionDate])
  @@map("production_batch")
  @@schema("public")
}

model ProductionBatchAnalysis {
  id                String          @id @default(uuid()) @db.Uuid
  productionBatchId String          @unique @map("production_batch_id") @db.Uuid
  assessment        Json            @db.JsonB
  guidance          Json?           @db.JsonB
  evidence          Json            @db.JsonB
  aiStatus          String          @map("ai_status") @db.Text
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  productionBatch   ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Restrict)

  @@index([productionBatchId, createdAt(sort: Desc)])
  @@map("production_batch_analyses")
  @@schema("public")
}

model ProductionBatchLine {
  productionBatchId   String          @map("production_batch_id") @db.Uuid
  productionLineId    String          @map("production_line_id") @db.Uuid
  manufacturingSiteId String          @map("manufacturing_site_id") @db.Uuid
  sequence            Int?
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  productionBatch     ProductionBatch @relation(fields: [productionBatchId, manufacturingSiteId], references: [id, manufacturingSiteId], onDelete: Cascade)
  productionLine      ProductionLine  @relation(fields: [productionLineId, manufacturingSiteId], references: [id, manufacturingSiteId], onDelete: Restrict)

  @@id([productionBatchId, productionLineId])
  @@index([productionBatchId, manufacturingSiteId])
  @@index([productionLineId, manufacturingSiteId])
  @@map("production_batch_lines")
  @@schema("public")
}

model ProductionBatchAuditEvent {
  id                String          @id @default(uuid()) @db.Uuid
  productionBatchId String          @map("production_batch_id") @db.Uuid
  actorUserId       String          @map("actor_user_id") @db.Uuid
  eventType         String          @map("event_type") @db.Text
  metadata          Json            @default("{}") @db.JsonB
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  productionBatch   ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Restrict)
  actorUser         Profile         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([productionBatchId, createdAt(sort: Desc)])
  @@index([actorUserId])
  @@map("production_batch_audit_events")
  @@schema("public")
}
