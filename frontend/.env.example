# The LAUT backend. Every domain read and write goes through it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase project, used for authentication only — the frontend never queries
# Postgres directly. Take both values from the same project the backend points at,
# otherwise the access token will not be accepted.
# Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
